#!/usr/bin/env bash
# =============================================================================
# vpn - a tiny command-line wrapper around `openconnect`
#
# Usage:
#   vpn                      Connect (runs in the background)
#   vpn off                  Disconnect
#   vpn status               Show whether the VPN is running
#   vpn setup                Enter server/username/password (asked automatically on first run)
#   vpn change-server HOST   Switch to another server (reconnects if connected)
#   vpn --help | --version
#
# Why "#!/usr/bin/env bash"?
#   The script is written for bash. Thanks to the shebang line it runs under
#   bash no matter which shell you type the command in (zsh, fish, dash, ...).
#   Just run it as `vpn`; do NOT `source` it from a non-bash shell.
#
# Credentials and the server name are NOT stored in this file. On the first
# run the script asks for them and saves them to a private config file
# (see CONFIG_FILE below).
# =============================================================================

set -u   # treat use of unset variables as an error (catches typos)

VERSION="1.0.0"

# Where the config lives. Respects XDG_CONFIG_HOME; can be overridden with the
# VPN_CONFIG environment variable (handy for testing or multiple profiles).
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/vpn-cli"
CONFIG_FILE="${VPN_CONFIG:-$CONFIG_DIR/config}"

# -----------------------------------------------------------------------------
# Helper functions
# -----------------------------------------------------------------------------

# Print an error message to stderr and exit with failure.
die() {
    echo "Error: $*" >&2
    exit 1
}

# Make sure every command passed as an argument is installed.
require_cmd() {
    for cmd in "$@"; do
        command -v "$cmd" >/dev/null 2>&1 || die "'$cmd' is not installed."
    done
}

# Return 0 if an openconnect process is running, 1 otherwise.
is_running() {
    pgrep -x openconnect >/dev/null 2>&1
}

usage() {
    cat <<'EOF'
vpn - connect to a VPN with openconnect from the terminal

Usage:
  vpn                      Connect (runs in the background)
  vpn off                  Disconnect
  vpn status               Show connection status
  vpn setup                Enter (or re-enter) server, username and password
  vpn change-server HOST   Change the server and reconnect
  vpn --help               Show this help
  vpn --version            Show the version

Config file: ~/.config/vpn-cli/config
EOF
}

# Interactively ask for the server, username and password, then save them
# to the config file. Runs automatically on first use, or on demand: `vpn setup`.
setup() {
    # Prompts need a real terminal (not a pipe or cron job).
    [ -t 0 ] || die "setup needs an interactive terminal.
       Create $CONFIG_FILE manually instead (see config.example)."

    # Don't silently destroy an existing config.
    if [ -f "$CONFIG_FILE" ]; then
        local answer
        read -r -p "A config already exists at $CONFIG_FILE. Overwrite it? [y/N] " answer
        case "$answer" in
            y|Y|yes|YES) ;;
            *) echo "Setup cancelled."; exit 0 ;;
        esac
    fi

    local server user pass pass2 attempt max_retries msg

    read -r -p "VPN server (hostname, e.g. vpn.example.com): " server
    [ -n "$server" ] || die "server cannot be empty."
    # Only hostname/IP-style characters are allowed.
    case "$server" in
        *[!A-Za-z0-9.-]*) die "invalid hostname: $server" ;;
    esac

    read -r -p "Username: " user
    [ -n "$user" ] || die "username cannot be empty."

    # -s = don't echo the password while typing. Ask twice to catch typos.
    # If the two entries differ (or are empty) we let the user try again up to
    # max_retries times. After the last retry also fails, setup is cancelled
    # and nothing is saved. Both fields are asked again each time, because we
    # cannot know which of the two was mistyped.
    attempt=0
    max_retries=3
    while true; do
        read -r -s -p "Password: " pass; echo
        read -r -s -p "Confirm password: " pass2; echo

        if [ -z "$pass" ]; then
            msg="the password cannot be empty."
        elif [ "$pass" != "$pass2" ]; then
            msg="the confirmation does not match the password."
        else
            break   # both entries match: continue and save
        fi

        if [ "$attempt" -ge "$max_retries" ]; then
            die "you entered the password wrong $max_retries times.
       Setup closed and nothing was saved. Run 'vpn setup' to start again."
        fi

        attempt=$((attempt + 1))
        echo "Error: $msg Try again ($attempt/$max_retries)." >&2
    done

    # Write the file inside a subshell with umask 077, so it is created
    # private (owner-only) from the very first moment: no window where other
    # users could read it. printf %q escapes special characters so the value
    # is always read back exactly as typed ($, ", spaces, backslashes, ...).
    (
        umask 077
        mkdir -p "$(dirname "$CONFIG_FILE")"
        {
            echo "# vpn-cli config (generated by 'vpn setup'). Keep this file private."
            printf 'VPN_SERVER=%q\n'   "$server"
            printf 'VPN_USERNAME=%q\n' "$user"
            printf 'VPN_PASSWORD=%q\n' "$pass"
        } > "$CONFIG_FILE"
    ) || die "could not write $CONFIG_FILE"
    chmod 600 "$CONFIG_FILE"

    echo "Saved to $CONFIG_FILE"
}

# Load VPN_SERVER, VPN_USERNAME and VPN_PASSWORD from the config file.
load_config() {
    # First run: no config yet, so ask the user for the details and save them.
    if [ ! -f "$CONFIG_FILE" ]; then
        echo "No config found. Let's set up your VPN (first run only)."
        setup
    fi

    # The file holds a password, so refuse to use it if other users can read it.
    # `find -perm /077` matches any group/other permission bit (works on GNU find).
    if [ -n "$(find "$CONFIG_FILE" -perm /077 2>/dev/null)" ]; then
        die "$CONFIG_FILE is readable by other users.
       Fix it with: chmod 600 $CONFIG_FILE"
    fi

    # The config is a plain shell file with VAR="value" lines.
    # shellcheck disable=SC1090
    . "$CONFIG_FILE"

    # ${VAR:?msg} aborts with msg if the variable is unset or empty.
    : "${VPN_SERVER:?VPN_SERVER is not set in $CONFIG_FILE}"
    : "${VPN_USERNAME:?VPN_USERNAME is not set in $CONFIG_FILE}"
    : "${VPN_PASSWORD:?VPN_PASSWORD is not set in $CONFIG_FILE}"
}

# -----------------------------------------------------------------------------
# Commands
# -----------------------------------------------------------------------------

connect() {
    require_cmd openconnect expect sudo pgrep setsid
    load_config

    if is_running; then
        echo "VPN is already running. Use 'vpn off' to disconnect first."
        return 1
    fi

    # IMPORTANT: sudo runs OUTSIDE of expect, in your real terminal.
    # If sudo ran inside expect, its password prompt would appear in a hidden
    # pseudo-terminal: expect would not forward your typing (so the password
    # was shown on screen) and the script would hang. Running the whole expect
    # process as root means:
    #   - sudo asks for your password normally (hidden, as usual), and
    #   - expect then starts openconnect directly, with no second sudo.
    #
    # The VPN username/password are handed to expect through stdin (a pipe),
    # so they never appear in `ps`, in the environment, or in a file on disk.
    # sudo still prompts on the real terminal (/dev/tty), not on this pipe.

    # The expect script that answers openconnect's interactive prompts.
    # Single-quoted heredoc: bash leaves everything alone, expect handles it.
    local expect_script
    read -r -d '' expect_script <<'EOF'
# Read credentials from the pipe (line 1: server, 2: username, 3: password)
gets stdin server
gets stdin user
gets stdin pass

set timeout 60
set tries 0
log_user 0                  ;# hide expect's own "spawn ..." line
# "setsid -w" puts openconnect in its own session, with no controlling terminal.
# Without it, when expect finishes and closes its pseudo-terminal, the kernel
# sends SIGHUP to openconnect and it exits right after going to the background
# ("User detached from session (SIGHUP); exiting"). -w keeps the terminal alive
# until openconnect has finished logging in and forked into the background.
spawn setsid -w openconnect --server=$server --background --no-dtls
log_user 1                  ;# but show openconnect's messages
expect {
    "Enter 'yes' to accept" {
        # Untrusted/self-signed certificate: accept it (as the original script did)
        send "yes\r"
        exp_continue
    }
    "Username:" {
        send -- "$user\r"
        exp_continue
    }
    "Password:" {
        # If the prompt appears twice, the login was rejected. Stop instead of
        # retrying forever (repeated failures can lock the account).
        incr tries
        if {$tries > 1} {
            puts "\nLogin failed: wrong username or password?"
            exit 1
        }
        send -- "$pass\r"
        exp_continue
    }
    timeout {
        puts "\nTimed out waiting for the VPN server."
        exit 1
    }
    eof
}
EOF

    printf '%s\n%s\n%s\n' "$VPN_SERVER" "$VPN_USERNAME" "$VPN_PASSWORD" \
        | sudo expect -c "$expect_script" \
        || die "could not connect (see the message above)."

    # openconnect forks to the background once connected, so check it is alive.
    sleep 1
    if is_running; then
        echo "VPN connected to $VPN_SERVER."
    else
        die "connection failed."
    fi
}

disconnect() {
    require_cmd sudo pkill
    if is_running; then
        # -x = match the exact process name, so we never kill unrelated programs.
        sudo pkill -x openconnect
        echo "VPN disconnected."
    else
        echo "VPN is not running."
    fi
}

show_status() {
    if is_running; then
        echo "VPN is running."
    else
        echo "VPN is not running."
        return 1
    fi
}

change_server() {
    local new_server="${1:-}"

    [ -n "$new_server" ] || die "usage: vpn change-server <hostname>"

    # Only allow hostname/IP-style characters. This keeps odd input
    # (quotes, spaces, $, ...) out of the config file.
    case "$new_server" in
        *[!A-Za-z0-9.-]*) die "invalid hostname: $new_server" ;;
    esac

    # Make sure the name actually resolves before we save it.
    getent hosts "$new_server" >/dev/null 2>&1 \
        || die "cannot resolve $new_server. Server not changed."

    load_config   # also verifies the file exists and has safe permissions

    # Rewrite the config: drop the old VPN_SERVER line, append the new one.
    # We write to a temp file and `mv` it so the config is never half-written.
    local tmp
    tmp="$(mktemp "$CONFIG_FILE.XXXXXX")" || die "cannot create temp file."
    grep -v '^VPN_SERVER=' "$CONFIG_FILE" > "$tmp"
    printf 'VPN_SERVER="%s"\n' "$new_server" >> "$tmp"
    chmod 600 "$tmp"
    mv "$tmp" "$CONFIG_FILE"

    echo "Server changed to $new_server."

    # If we were connected, reconnect to the new server.
    if is_running; then
        disconnect
        sleep 1
        connect
    fi
}

# -----------------------------------------------------------------------------
# Entry point
# -----------------------------------------------------------------------------

case "${1:-connect}" in
    connect|on)        connect ;;
    off|disconnect)    disconnect ;;
    status)            show_status ;;
    setup)             setup ;;
    change-server)     change_server "${2:-}" ;;
    -h|--help|help)    usage ;;
    -v|--version)      echo "vpn $VERSION" ;;
    *)                 usage; exit 1 ;;
esac
